@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Access Denied - GYM System</title>
    <link rel="stylesheet" href="/css/auth.css" />
</head>
<body>

    <nav class="auth-navbar">
        <div class="nav-logo">
            <img src="/image/logo.png" alt="FitZone Logo" onerror="this.style.display='none'" />
            FitZone GYM
        </div>
        <a href="/Home/Index" class="back-home-btn">← Back to Home</a>
    </nav>

    <div class="auth-wrapper">
        <div class="auth-box">
            <div class="auth-header">
                <h2>🚫 Access Denied</h2>
                <p class="subtitle">You don't have permission to view this page.</p>
            </div>
            <div class="auth-body">
                <p style="text-align:center; color:#888; font-size:13px; margin-bottom:16px;">
                    This page is only available to certain account types.
                </p>
                <a href="/Home/Index" class="btn-view-gym" style="display:block; text-align:center; text-decoration:none; padding:12px; background:#4a4ae0; color:#fff; border-radius:6px;">
                    Back to Home
                </a>
            </div>
        </div>
    </div>

</body>
</html>
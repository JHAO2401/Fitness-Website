@{
    ViewData["Title"] = "Login";
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login - GYM System</title>
    <link rel="icon" type="image/png" href="/image/logo.png" />
    <link rel="stylesheet" href="/css/auth.css" />
</head>
<body>

    <nav class="auth-navbar">
        <div class="nav-logo">
            <img src="/image/logo.png" alt="FitZone Logo" onerror="this.style.display='none'" />
            FitZone GYM
        </div>
        <a href="/Home/Index" class="back-home-btn">← Back to Home</a>
    </nav>

    <div class="auth-wrapper">
        <div class="auth-box">
            <div class="auth-header">
                <h2>Welcome Back</h2>
                <p class="subtitle">Sign in to your GYM account</p>
            </div>

            <div class="auth-tabs">
                <a href="/Account/Login" class="active">Sign In</a>
                <a href="/Account/Register">Register</a>
            </div>

            <div class="auth-body">
                <div class="summary-error" id="summaryError"></div>

                <form id="loginForm" novalidate>
                    <div class="form-group">
                        <label for="Email">Email</label>
                        <input type="email" id="Email" name="Email" placeholder="you@example.com" />
                        <div class="field-error" id="emailError"></div>
                    </div>

                    <div class="form-group">
                        <label for="Password">Password</label>
                        <input type="password" id="Password" name="Password" placeholder="Your password" />
                        <div class="field-error" id="passwordError"></div>
                    </div>

                    <button type="submit" id="loginBtn">Sign In</button>
                </form>

                <div class="switch-link">
                    Don't have an account? <a href="/Account/Register">Register here</a>
                </div>

                @* <div class="admin-link">
                    <a href="/Account/AdminRegister">Admin Login / Setup →</a>
                </div> *@
            </div>
        </div>
    </div>

    <script src="/js/auth.js"></script>
    <script>
        initLoginForm('@returnUrl');
    </script>
</body>
</html>
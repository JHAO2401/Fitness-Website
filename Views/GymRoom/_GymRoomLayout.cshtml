@using System.Security.Claims
@using GYM.Data
@inject ApplicationDbContext DbContext
@{
    Layout = null;
    bool isLoggedIn = User.Identity != null && User.Identity.IsAuthenticated;
    var currentFullName = "";
    var currentAvatarUrl = "";
    if (isLoggedIn)
    {
        var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!string.IsNullOrEmpty(userIdClaim))
        {
            var currentUser = await DbContext.Users.FindAsync(int.Parse(userIdClaim));
            if (currentUser != null)
            {
                currentFullName = currentUser.FullName;
                currentAvatarUrl = currentUser.AvatarUrl ?? "";
            }
        }
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FitZone GYM</title>
    <link rel="icon" type="image/png" href="/image/logo.png" />
    <link rel="stylesheet" href="/css/gymroom.css?v=1" />
    <link rel="stylesheet" href="/css/admin-dashboard.css" />
</head>
<body>

    <nav class="member-navbar">
        <div class="member-nav-logo">
            <img src="/image/logo.png" alt="Logo" onerror="this.style.display='none'" />
            <span>FitZone GYM</span>
        </div>

        <div class="member-nav-links">
            <a href="/GymRoom/OurGym" class="@(ViewData["Active"] as string == "ourgym" ? "active" : "")">Find Our Gym</a>
            <a href="/GymRoom/TrainerList" class="@(ViewData["Active"] as string == "trainerlist" ? "active" : "")">Trainer List</a>
            <a href="/GymRoom/Chat" class="@(ViewData["Active"] as string == "chat" ? "active" : "")">Chat</a>
            <a href="/GymRoom/Quest" class="@(ViewData["Active"] as string == "quest" ? "active" : "")">Quest</a>
        </div>

        @if (isLoggedIn)
        {
            <a href="/Member/Profile" class="member-user-badge">
                <img src="@(string.IsNullOrEmpty(currentAvatarUrl) ? "/image/logo.png" : currentAvatarUrl)"
                     alt="Avatar"
                     class="member-topbar-avatar"
                     onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><circle cx=%2250%22 cy=%2250%22 r=%2250%22 fill=%22%23ddd%22/><text x=%2250%22 y=%2262%22 font-size=%2245%22 text-anchor=%22middle%22>👤</text></svg>';" />
                <span>@currentFullName</span>
            </a>
        }
        else
        {
            <a href="/Account/Login" class="member-login-btn">Login / Register</a>
        }
    </nav>

    <main class="member-page-body">
        @RenderBody()
    </main>

    <footer class="member-footer">
        &copy; 2026 FitZone GYM
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
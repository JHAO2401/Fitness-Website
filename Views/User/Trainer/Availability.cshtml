@model List<GYM.Models.ViewModels.AvailableSlotViewModel>
@{
    Layout = "~/Views/User/Trainer/_TrainerLayout.cshtml";
}

<div class="panel">
    <div class="panel-header">
        <h2>Add New Time Slot</h2>
    </div>
    <div class="panel">
        <div class="panel-header">
            <h2>Add New Time Slot</h2>
        </div>
        <div class="profile-form-body">
            <div class="field-hint" style="margin-bottom:14px;">
                🕒 Gym Operating Hours: <strong>@ViewBag.OperatingHours</strong> — slots must fall within this range.
            </div>
            <div class="summary-error" id="addSlotError"></div>
            <div class="summary-success" id="addSlotSuccess"></div>

            <form id="addSlotForm" novalidate>
            <div class="slot-form-row">
                <div class="form-group">
                    <label for="SlotDate">Date</label>
                    <input type="date" id="SlotDate" />
                </div>
                <div class="form-group">
                    <label for="SlotStart">Start Time</label>
                    <input type="time" id="SlotStart" />
                </div>
                <div class="form-group">
                    <label for="SlotEnd">End Time</label>
                    <input type="time" id="SlotEnd" />
                </div>
            </div>
            <button type="submit" id="addSlotBtn">+ Add Slot</button>
        </form>
    </div>
</div>

<div class="panel" style="margin-top:24px;">
    <div class="panel-header">
        <h2>My Upcoming Slots</h2>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state" id="emptyState">No upcoming slots. Add one above.</div>
    }
    else
    {
        <table id="slotsTable">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="slotsTableBody">
                @foreach (var slot in Model)
                {
                    <tr id="slot-row-@slot.SlotId" data-slot-id="@slot.SlotId">
                        <td>@slot.Date.ToString("dd MMM yyyy")</td>
                        <td>@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</td>
                        <td>
                            @if (slot.IsBooked)
                            {
                                <span class="appt-status Confirmed">Booked</span>
                            }
                            else
                            {
                                <span class="appt-status" style="background:#e0ffe8;color:#1a7f3c;">Open</span>
                            }
                        </td>
                        <td>
                            @if (!slot.IsBooked)
                            {
                                <button type="button" class="action-btn deactivate" onclick="deleteSlot(@slot.SlotId, this)">Delete</button>
                            }
                            else
                            {
                                <span class="protected-text">Booked</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('SlotDate').min = new Date().toISOString().split('T')[0];

        document.getElementById('addSlotForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const errorEl = document.getElementById('addSlotError');
            const successEl = document.getElementById('addSlotSuccess');
            errorEl.style.display = 'none';
            successEl.style.display = 'none';

            const date = document.getElementById('SlotDate').value;
            const start = document.getElementById('SlotStart').value;
            const end = document.getElementById('SlotEnd').value;

            if (!date || !start || !end) {
                errorEl.textContent = 'Please fill in date, start time, and end time';
                errorEl.style.display = 'block';
                return;
            }

            const btn = document.getElementById('addSlotBtn');
            btn.disabled = true;
            btn.textContent = 'Adding...';

            try {
                const response = await fetch('/Trainer/AddSlot', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Date: date, StartTime: start, EndTime: end })
                });
                const result = await response.json();

                if (result.success) {
                    successEl.textContent = 'Slot added successfully.';
                    successEl.style.display = 'block';
                    setTimeout(() => location.reload(), 800);
                } else {
                    errorEl.textContent = result.errors.join(' ');
                    errorEl.style.display = 'block';
                }
            } catch (err) {
                errorEl.textContent = 'Something went wrong. Please try again.';
                errorEl.style.display = 'block';
            } finally {
                btn.disabled = false;
                btn.textContent = '+ Add Slot';
            }
        });

        async function deleteSlot(slotId, btn) {
            if (!confirm('Delete this time slot?')) return;

            btn.disabled = true;
            btn.textContent = 'Deleting...';

            try {
                const response = await fetch('/Trainer/DeleteSlot', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ slotId: slotId })
                });
                const result = await response.json();

                if (result.success) {
                    const row = document.getElementById('slot-row-' + slotId);
                    if (row) row.remove();
                } else {
                    alert(result.message || 'Failed to delete slot');
                    btn.disabled = false;
                    btn.textContent = 'Delete';
                }
            } catch (err) {
                alert('Something went wrong. Please try again.');
                btn.disabled = false;
                btn.textContent = 'Delete';
            }
        }
    </script>
}
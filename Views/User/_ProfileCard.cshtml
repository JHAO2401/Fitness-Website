<div class="modal-section">
    <p class="modal-section-label">User Profile</p>

    <div class="modal-avatar-row">
        <img id="modalAvatar"
             src="/image/logo.png"
             alt="Avatar"
             class="modal-avatar-img"
             onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><circle cx=%2250%22 cy=%2250%22 r=%2250%22 fill=%22%23e5e5ea%22/><text x=%2250%22 y=%2262%22 font-size=%2245%22 text-anchor=%22middle%22>👤</text></svg>';" />
        <div class="modal-avatar-name" id="modalAvatarName"></div>
    </div>

    <div class="modal-profile-grid">
        <div class="modal-profile-row">
            <span class="modal-profile-label">Email</span>
            <span class="modal-profile-value" id="modalEmail"></span>
        </div>
        <div class="modal-profile-row">
            <span class="modal-profile-label">Phone</span>
            <span class="modal-profile-value" id="modalPhone"></span>
        </div>
        <div class="modal-profile-row">
            <span class="modal-profile-label">Role</span>
            <span class="modal-profile-value" id="modalRole"></span>
        </div>
        <div class="modal-profile-row">
            <span class="modal-profile-label">Status</span>
            <span class="modal-profile-value" id="modalStatus"></span>
        </div>
        <div class="modal-profile-row">
            <span class="modal-profile-label">Failed Attempts</span>
            <span class="modal-profile-value" id="modalFailedAttempts"></span>
        </div>
        <div class="modal-profile-row">
            <span class="modal-profile-label">Joined</span>
            <span class="modal-profile-value" id="modalJoined"></span>
        </div>
    </div>
</div>
@model GYM.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "GYM System - Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FitZone GYM</title>
    <link rel="icon" type="image/png" href="/image/logo.png" />
    <link rel="stylesheet" href="~/css/home.css" />
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="nav-logo">
            <img src="/image/logo.png" alt="FitZone Logo" onerror="this.style.display='none'" />
            FitZone GYM
        </div>
        <div class="nav-links">
            <a href="/GymRoom/OurGym">Find Our Gym</a>
            <a href="/GymRoom/TrainerList">Trainer List</a>
            <a href="/GymRoom/Chat">Chat</a>
            <a href="/GymRoom/Quest">Quest</a>
            <a href="/Account/Register" class="btn-pill">Here to register</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero" id="top">
        <div class="hero-overlay"></div>
        <div class="hero-bg" style="background-image: url('/image/background.png');"></div>

        <div class="hero-content">
            <h1>TRAIN FOR YOUR<br /><span>FULLEST LIFE</span></h1>
            <p class="hero-sub">ONLY AT <strong>FITZONE GYM</strong></p>

            <div class="hero-stats">
                <div class="stat-item">
                    <div class="stat-icon">🧑‍🏫</div>
                    <div class="stat-text"><strong>@Model.TrainerCount</strong><span>Certified Trainers</span></div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">👥</div>
                    <div class="stat-text"><strong>@Model.MemberCount</strong><span>Active Members</span></div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">📍</div>
                    <div class="stat-text"><strong>@Model.LocationCount</strong><span>Prime Location</span></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Dark CTA Strip -->
    <section class="cta-strip">
        <div class="cta-strip-content">
            <h2>Ready to Get Started?</h2>
            <a href="/GymRoom/OurGym" class="btn-view-gym">View Our GYM</a>
            <p class="cta-sub">Book a session with our trainers and start your journey today.</p>
        </div>
    </section>

    <!-- Footer -->

</body>
</html>